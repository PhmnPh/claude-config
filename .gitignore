# Whitelist: only skills and the global CLAUDE.md are versioned.
# settings.json stays out on purpose: its autoMode block lists internal work hostnames.
/*
!/.gitignore
!/README.md
!/CLAUDE.md
!/skills/
!/agents/
!/vendor/
# Omarchy system skills, symlinked into skills/ by the OS. Not ours.
/skills/omarchy
/skills/diagnose-crash
